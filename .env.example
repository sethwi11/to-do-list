# Optional. The app needs no API keys and no paid services; copy this file to
# .env only if you want to change one of these. .env is gitignored.

# Port for the Express API server. The Vite dev server reads this too, to proxy /api to it.
API_PORT=3001

# Where the SQLite database file lives (relative to /server).
# DB_PATH=data/todo.db

# Where uploaded files (attachments) are kept (relative to /server). Default: an `uploads` folder next to the database.
# UPLOADS_DIR=data/uploads
