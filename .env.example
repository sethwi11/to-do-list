# Copy this file to .env and fill in real values. .env is gitignored.

# Get a key at https://console.anthropic.com/ (Settings -> API Keys).
# Not needed until Phase 3 (AI extraction).
ANTHROPIC_API_KEY=

# Port for the Express API server. The Vite dev server reads this too, to proxy /api to it.
API_PORT=3001

# Optional: where the SQLite database file lives (relative to /server).
# DB_PATH=data/todo.db
