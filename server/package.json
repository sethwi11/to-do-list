{
  "name": "@todo/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --exclude \"../node_modules/**\" --exclude \"data/**\" src/index.ts",
    "start": "tsx src/index.ts",
    "seed:week": "tsx scripts/seedWeek.ts",
    "carry-over": "tsx scripts/carryOver.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@todo/shared": "*",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "multer": "^2.5.0",
    "node-notifier": "^10.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^20.19.0",
    "@types/node-notifier": "^8.0.5",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "vitest": "^4.1.12"
  }
}
